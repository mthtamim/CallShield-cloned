<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            style="@style/CS.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textColor="@color/cs_accent_dark" />

        <TextView
            android:id="@+id/textWizardStepTitle"
            style="@style/CS.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/textWizardBody"
            style="@style/CS.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wizard_setup_required"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textWizardProgress"
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <ProgressBar
                android:id="@+id/progressWizard"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:progressTint="@color/cs_accent"
                android:progressBackgroundTint="@color/cs_divider" />

            <LinearLayout
                android:id="@+id/layoutWizardRequired"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/textWizardStatus"
                style="@style/CS.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnWizardAction"
                style="@style/CS.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/wizard_setup_next" />
        </LinearLayout>

        <LinearLayout
            style="@style/CS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/CS.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wizard_setup_optional"
                android:textSize="18sp" />

            <TextView
                style="@style/CS.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/wizard_setup_optional_body" />

            <LinearLayout
                android:id="@+id/layoutWizardOptional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/btnWizardNext"
            style="@style/CS.ButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:text="@string/wizard_setup_continue" />

    </LinearLayout>
</ScrollView>
