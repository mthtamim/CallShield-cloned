<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        style="@style/CS.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/CS.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_title"
            android:textSize="25sp" />

        <TextView
            style="@style/CS.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lock_desc" />

        <EditText
            android:id="@+id/editPin"
            style="@style/CS.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:hint="@string/pin_hint"
            android:inputType="numberPassword"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btnUnlock"
            style="@style/CS.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lock_unlock" />

        <Button
            android:id="@+id/btnBiometric"
            style="@style/CS.ButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/lock_biometric" />

        <TextView
            android:id="@+id/textLockError"
            style="@style/CS.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</LinearLayout>