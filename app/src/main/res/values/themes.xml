<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CallShield" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/cs_bg</item>
        <item name="android:statusBarColor">@color/cs_bg</item>
        <item name="android:navigationBarColor">@color/cs_bottombar</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        <item name="colorAccent">@color/cs_accent</item>
        <item name="colorControlActivated">@color/cs_accent</item>
        <item name="editTextStyle">@style/CS.Input</item>
        <item name="spinnerStyle">@style/CS.Spinner</item>
    </style>

    <style name="CS.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="CS.Heading" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cs_text</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <style name="CS.Body" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/cs_text_body</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="CS.StatTile" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="CS.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/cs_text_secondary</item>
    </style>

    <style name="CS.Button" parent="">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/cs_on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="CS.CardMenu" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">0dp</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="CS.MenuRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CS.MenuTile" parent="">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:padding">11dp</item>
    </style>

    <style name="CS.MenuStatus" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/cs_accent_dark</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="CS.ButtonSecondary" parent="">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/cs_accent_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="CS.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/cs_text</item>
        <item name="android:textColorHint">@color/cs_text_secondary</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="CS.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:popupBackground">@color/cs_card</item>
    </style>
</resources>
